<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP so a phone or tablet can reach a dev server on the home network
     (e.g. http://192.168.1.20:8787). The app itself still accepts HTTP only for loopback, the emulator
     host and private LAN addresses (ApiClient.validate); release builds stay HTTPS-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
