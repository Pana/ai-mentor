# Copy to .env; never commit the real values.
HOST=127.0.0.1
PORT=8787
# Generate a random device credential: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TUTOR_DEVICE_TOKEN=
# Full HTTPS chat/completions URL supplied by your model vendor.
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_JSON_MODE=true
# Optional: a separate image-capable model on the same vendor, used only for requests with a photo.
MODEL_VISION_NAME=
# Set to false when MODEL_NAME cannot read images and no MODEL_VISION_NAME is set:
# photo requests then get a clear 422 images_not_supported instead of an upstream failure.
MODEL_SUPPORTS_IMAGES=true
