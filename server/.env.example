# Copy to .env; never commit the real values.
HOST=127.0.0.1
PORT=8787
# Generate a random device credential: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TUTOR_DEVICE_TOKEN=
# Phase-1 homework API. The parent iPhone exchanges this secret once for its own device credential.
# Generate it the same way as TUTOR_DEVICE_TOKEN. Leave empty to disable the homework API.
PARENT_BOOTSTRAP_TOKEN=
# Database and uploaded photos/recordings. Back this directory up.
DATA_DIR=./data
# Full HTTPS chat/completions URL supplied by your model vendor.
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_JSON_MODE=true
# Optional: model for the hanzi dictionary (/hanzi/); defaults to MODEL_NAME.
HANZI_MODEL_NAME=
# Volcengine/Doubao streaming ASR for Hanzi voice input. Keep the API key server-side.
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
# Voice teacher (/v1/teacher): streaming ASR with interim text, and speech synthesis.
VOLC_ASR_STREAM_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# Defaults to VOLC_ASR_API_KEY. Without a speaker the teacher shows captions but does not speak.
VOLC_TTS_API_KEY=
VOLC_TTS_SPEAKER=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLC_TTS_SPEECH_RATE=0
# Optional: model for the voice teacher; defaults to MODEL_NAME.
TEACHER_MODEL_NAME=
# Optional: a separate image-capable model on the same vendor, used only for requests with a photo.
MODEL_VISION_NAME=
# Set to false when MODEL_NAME cannot read images and no MODEL_VISION_NAME is set:
# photo requests then get a clear 422 images_not_supported instead of an upstream failure.
MODEL_SUPPORTS_IMAGES=true
# Realtime voice endpoint: /v1/voice over WebSocket. Keep mock mode for local
# UI/protocol tests until a provider adapter is configured.
VOICE_MOCK=true
