// Signing settings shared by all configurations.
// Put your own team (and, if needed, a unique bundle id) in Config/Local.xcconfig — it is git-ignored:
//   DEVELOPMENT_TEAM = ABCDE12345
//   PRODUCT_BUNDLE_IDENTIFIER = cn.littlebear.tutor.yourname
CODE_SIGN_STYLE = Automatic
PRODUCT_BUNDLE_IDENTIFIER = cn.littlebear.tutor.ipad
#include? "Local.xcconfig"
